{
  "name": "mcp-comfyui",
  "version": "0.1.0",
  "description": "MCP server that finds ComfyUI workflows, learns each one's inputs as typed JSON Schema, and runs them — driving comfy-cli rather than talking to ComfyUI directly",
  "module": "src/index.ts",
  "type": "module",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuesdayCrowd/mcp-comfyui.git"
  },
  "homepage": "https://github.com/TuesdayCrowd/mcp-comfyui#readme",
  "bugs": {
    "url": "https://github.com/TuesdayCrowd/mcp-comfyui/issues"
  },
  "keywords": [
    "mcp",
    "comfyui",
    "model-context-protocol",
    "stable-diffusion",
    "claude"
  ],
  "bin": {
    "mcp-comfyui": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "UNLICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "deno task test",
    "build": "node scripts/build.mjs",
    "compile": "deno task compile",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "zod": "4.4.3"
  }
}
