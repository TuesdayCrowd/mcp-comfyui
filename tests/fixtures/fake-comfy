#!/bin/sh
# A fake `comfy` for tests: no ComfyUI, no network, no Python, no dependencies
# beyond POSIX sh builtins.
#
#   $FAKE_COMFY_MODE       selects the canned response (default: a success envelope)
#   $FAKE_COMFY_ARGV_OUT   file to record this invocation's argv in, so tests can
#                          assert that global flags precede the subcommand
#   $FAKE_COMFY_PID_OUT    file to record this process's pid in, so tests can
#                          prove a timed-out child was actually killed
#   $FAKE_COMFY_ORPHAN_OUT file to record a surviving descendant's pid in
#   $FAKE_COMFY_PROBE      value echoed back by the echo_env mode
#   $FAKE_COMFY_DATA_FILE  JSON file served as the envelope's data (data_file mode)
#   $FAKE_COMFY_ERROR_CODE     error code returned by the fail_code and
#                              launch_fail modes
#   $FAKE_COMFY_ERROR_MESSAGE  error message returned by the fail_code and
#                              launch_fail modes
#   $FAKE_COMFY_APPLIED        set_slot: literal JSON array to report as
#                              data.applied instead of echoing what arrived
#   $FAKE_COMFY_WARNINGS       set_slot: literal JSON array for data.warnings
#   $FAKE_COMFY_WROTE_NULL     set_slot: report data.wrote as null, as --stdout does
#   $FAKE_COMFY_STREAM_FILE    run_stream: file whose bytes become stdout verbatim
#   $FAKE_COMFY_STDERR         run_stream: one line of human chatter for stderr
#   $FAKE_COMFY_EXIT           run_stream: exit code to end with (default 0)
#   $FAKE_COMFY_HANG          run_stream: block after the stream instead of exiting
#   $FAKE_COMFY_WORKFLOW_COPY  run_capture: file the workflow named by --workflow is
#                              copied to, so a test can assert on the exact bytes that
#                              reached `comfy run`
#   $FAKE_COMFY_ARGV_LOG       jobs: file each invocation's argv is APPENDED to,
#                              because one cancel makes two calls and
#                              $FAKE_COMFY_ARGV_OUT only ever holds the last
#   $FAKE_COMFY_JOBS_STATUS_FILE   jobs status: JSON file served as data
#   $FAKE_COMFY_JOBS_STATUS_ERROR  jobs status: error code to fail with instead
#   $FAKE_COMFY_JOBS_LS_FILE       jobs ls: JSON file served as data
#   $FAKE_COMFY_JOBS_LS_ERROR      jobs ls: error code to fail with instead
#   $FAKE_COMFY_JOBS_CANCEL_FILE   jobs cancel: JSON file served as data
#   $FAKE_COMFY_JOBS_CANCEL_ERROR  jobs cancel: error code to fail with instead
#   $FAKE_COMFY_TEMPLATES_FILE     templates_ls: JSON file served as data
#   $FAKE_COMFY_TEMPLATE_FILE      templates_fetch: file copied to the -o path
#   $FAKE_COMFY_VALIDATE_FILE     validate: JSON file served as data
#   $FAKE_COMFY_VALIDATE_OK        validate: envelope ok flag, "true" or "false" (default true)
#   $FAKE_COMFY_TEMPLATE_NAME      templates_fetch: name echoed back in data.name
#   $FAKE_COMFY_NOTES_FILE     notes_file: JSON file served as data; unset means
#                              a workflow that carries no notes

[ -n "$FAKE_COMFY_ARGV_OUT" ] && printf '%s\n' "$*" > "$FAKE_COMFY_ARGV_OUT"

OK='{"schema":"envelope/1","type":"envelope","ok":true,"command":"workflow slots","version":"0.0.0","where":null,"data":{"slots":[]},"error":null}'

case "$FAKE_COMFY_MODE" in
  fail)
    echo '{"schema":"envelope/1","type":"envelope","ok":false,"command":"run","version":"0.0.0","where":null,"data":null,"error":{"code":"server_unreachable","message":"connection refused","hint":"is ComfyUI running?","details":null}}'
    exit 1 ;;
  fail_rich)
    # Same failure shape, but with the routing target and details populated.
    echo '{"schema":"envelope/1","type":"envelope","ok":false,"command":"run","version":"0.0.0","where":"cloud","data":null,"error":{"code":"workflow_not_found","message":"no such file","hint":"check the path","details":{"tried":["a.json","b.json"]}}}'
    exit 1 ;;
  garbage)
    echo 'Traceback (most recent call last):' >&2
    echo 'RuntimeError: boom' >&2
    echo 'not json at all'
    exit 1 ;;
  stderr_noise)
    # Human-readable chatter on stderr, including something envelope-shaped.
    # Anything that parses stderr instead of stdout fails loudly here.
    echo 'WARNING: torch not compiled with CUDA enabled' >&2
    echo '{"schema":"envelope/1","type":"envelope","ok":false,"command":"workflow slots","version":"0.0.0","where":null,"data":null,"error":{"code":"stderr_was_parsed","message":"stderr must never be parsed","hint":null,"details":null}}' >&2
    echo "$OK"
    exit 0 ;;
  exit1_ok)
    # Exit code 1 is overloaded upstream; the envelope is the real signal.
    echo "$OK"
    exit 1 ;;
  hang)
    # The easy case: one process, still running, killable by pid.
    echo 'loading model checkpoint...' >&2
    [ -n "$FAKE_COMFY_PID_OUT" ] && printf '%s\n' "$$" > "$FAKE_COMFY_PID_OUT"
    # exec so the sleeper keeps this pid: the test asserts on this exact pid.
    exec sleep 30 ;;
  hang_ignore_sigterm)
    # Same as `hang`, but proves the SPECIFIC signal a timeout sends: `trap ''
    # TERM` sets SIGTERM to be ignored (SIG_IGN), and POSIX exec() preserves an
    # *ignored* disposition across exec (unlike a caught one, which resets to
    # the default action) -- so the execed `sleep` inherits SIGTERM-ignored and
    # can only be stopped by SIGKILL, which nothing can block or ignore.
    # Verified directly: `trap '' TERM; exec sleep N` survives SIGTERM and
    # dies immediately on SIGKILL.
    echo 'loading model checkpoint...' >&2
    [ -n "$FAKE_COMFY_PID_OUT" ] && printf '%s\n' "$$" > "$FAKE_COMFY_PID_OUT"
    trap '' TERM
    exec sleep 30 ;;
  orphan)
    # The hard case, and the one `comfy launch` will really produce: the child
    # exits immediately but leaves a descendant holding the stdout write end,
    # so the pipe never reaches EOF no matter what happens to the child's pid.
    echo 'starting server in the background' >&2
    sleep 30 &
    [ -n "$FAKE_COMFY_ORPHAN_OUT" ] && printf '%s\n' "$!" > "$FAKE_COMFY_ORPHAN_OUT"
    exit 0 ;;
  echo_env)
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"x","version":"0.0.0","where":null,"data":{"probe":"%s"},"error":null}\n' "$FAKE_COMFY_PROBE"
    exit 0 ;;
  flood)
    i=0
    while [ $i -lt 200 ]; do
      printf 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
      printf 'yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy' >&2
      i=$((i + 1))
    done
    exit 1 ;;
  cwd)
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"pwd","version":"0.0.0","where":null,"data":{"cwd":"%s"},"error":null}\n' "$(pwd -P)"
    exit 0 ;;
  data_file)
    # Wrap a JSON file as the envelope's data, so a test can serve real captured
    # output — or any variant of it — without a mode per payload.
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"workflow slots","version":"0.0.0","where":null,"data":'
    cat "$FAKE_COMFY_DATA_FILE"
    printf ',"error":null}\n'
    exit 0 ;;
  fail_code)
    # A failure envelope with a caller-chosen code, for testing how one
    # particular code is surfaced without pinning a mode to it.
    printf '{"schema":"envelope/1","type":"envelope","ok":false,"command":"workflow slots","version":"0.0.0","where":null,"data":null,"error":{"code":"%s","message":"%s","hint":null,"details":null}}\n' "$FAKE_COMFY_ERROR_CODE" "$FAKE_COMFY_ERROR_MESSAGE"
    exit 1 ;;
  set_slot)
    # `workflow set-slot` as it really behaves: it edits the file it was handed,
    # in place, and reports what it was asked to apply.
    #
    # The edit is an append of every ADDR=VALUE positional between markers,
    # rather than a real graph write, for two reasons. It needs no JSON parser —
    # sh has none, and a fake that re-serialised the graph would reintroduce the
    # very precision loss these tests exist to rule out — and it leaves the
    # original bytes ahead of it untouched, so a test can assert both what argv
    # carried and that the copy survived it. $FAKE_COMFY_ARGV_OUT cannot serve
    # the first job: a value may hold spaces, `=` or newlines, and joining argv
    # with spaces destroys all three.
    #
    # The file is the argument after `set-slot`; a pair is any later argument
    # that contains `=` and does not begin with `-`. That is enough to tell the
    # pairs from `--input <path>`, `--host <h>` and `--port <p>` as long as no
    # option value contains `=`, which is true of every path these tests use.
    target=""
    applied=""
    take_target=0
    for arg in "$@"; do
      if [ "$take_target" = 1 ]; then take_target=0; target="$arg"; continue; fi
      if [ "$arg" = "set-slot" ]; then take_target=1; continue; fi
      case "$arg" in
        -*) continue ;;
        *=*)
          printf '\n<<<PAIR\n%s\nPAIR>>>' "$arg" >> "$target"
          applied="${applied:+$applied,}\"${arg%%=*}\"" ;;
      esac
    done
    if [ -n "$FAKE_COMFY_APPLIED" ]; then applied="$FAKE_COMFY_APPLIED"; else applied="[$applied]"; fi
    if [ -n "$FAKE_COMFY_WROTE_NULL" ]; then wrote='null'; else wrote="\"$target\""; fi
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"workflow set-slot","version":"0.0.0","where":null,"data":{"workflow":"%s","applied":%s,"warnings":%s,"wrote":%s},"error":null,"changed":true}\n' \
      "$target" "$applied" "${FAKE_COMFY_WARNINGS:-[]}" "$wrote"
    exit 0 ;;
  run_stream)
    # `comfy run --json`, whose stdout is NDJSON rather than one envelope: zero
    # or more `event/1` lines and then a final `envelope/1`.
    #
    # The bytes come from a file the test wrote, on the same reasoning as
    # data_file above — one mode instead of one per stream shape, and the test
    # that asserts on a stream is the thing that spells it. Nothing here reads
    # or validates them, so a deliberately malformed stream stays malformed all
    # the way to the parser under test.
    #
    # stdout and stderr are separate pipes drained concurrently, so the order
    # of these two lines carries no meaning; stderr exists to prove it is never
    # parsed as data. The exit code is the caller's to choose because upstream
    # overloads 1 across every failure and returns 130 for a cancellation, so a
    # parser must never infer the outcome from it.
    [ -n "$FAKE_COMFY_STREAM_FILE" ] && cat "$FAKE_COMFY_STREAM_FILE"
    [ -n "$FAKE_COMFY_STDERR" ] && printf '%s\n' "$FAKE_COMFY_STDERR" >&2
    # $FAKE_COMFY_HANG turns the same stream into a `--wait` run that never
    # finishes: the events are flushed, then the process blocks holding stdout
    # open. That is what a real long render looks like to a caller whose budget
    # runs out, and the only way to test what is recoverable from a partial
    # stream. exec so the sleeper keeps this pid.
    [ -n "$FAKE_COMFY_HANG" ] && exec sleep 30
    exit "${FAKE_COMFY_EXIT:-0}" ;;
  run_capture)
    # `comfy run --json`, plus a copy of the graph it was handed.
    #
    # A NEW mode rather than a switch inside run_stream, because modes here are
    # append-only: every test written against run_stream must keep behaving
    # exactly as it did. What this adds is the only way to assert on the bytes
    # that actually reached the CLI — which is what pins landmine #1 for a
    # workflow fetched over HTTP, where there is no local file to compare
    # against afterwards (the prepared copy is deleted when the run returns).
    take=0
    for arg in "$@"; do
      if [ "$take" = 1 ]; then
        [ -n "$FAKE_COMFY_WORKFLOW_COPY" ] && cp "$arg" "$FAKE_COMFY_WORKFLOW_COPY"
        break
      fi
      [ "$arg" = "--workflow" ] && take=1
    done
    [ -n "$FAKE_COMFY_STREAM_FILE" ] && cat "$FAKE_COMFY_STREAM_FILE"
    [ -n "$FAKE_COMFY_STDERR" ] && printf '%s\n' "$FAKE_COMFY_STDERR" >&2
    exit "${FAKE_COMFY_EXIT:-0}" ;;
  jobs)
    # `comfy jobs`, dispatching on the subcommand: one cancel makes two calls
    # (a status probe, then the cancel), so a mode that served one fixed payload
    # could not stand in for it. The subcommand is the argument after `jobs`.
    #
    # $FAKE_COMFY_ARGV_OUT is written by the shared line at the top of this
    # file and holds only the LAST invocation, so an append-only log is offered
    # alongside it rather than changing that line for every other mode.
    [ -n "$FAKE_COMFY_ARGV_LOG" ] && printf '%s\n' "$*" >> "$FAKE_COMFY_ARGV_LOG"
    sub=""
    take=0
    for arg in "$@"; do
      if [ "$take" = 1 ]; then take=0; sub="$arg"; continue; fi
      [ "$arg" = "jobs" ] && take=1
    done
    case "$sub" in
      status) file="$FAKE_COMFY_JOBS_STATUS_FILE"; err="$FAKE_COMFY_JOBS_STATUS_ERROR" ;;
      ls)     file="$FAKE_COMFY_JOBS_LS_FILE";     err="$FAKE_COMFY_JOBS_LS_ERROR" ;;
      cancel) file="$FAKE_COMFY_JOBS_CANCEL_FILE"; err="$FAKE_COMFY_JOBS_CANCEL_ERROR" ;;
      *)      file=""; err="unknown_subcommand" ;;
    esac
    # A subcommand the test never armed is a fault in the test, not a payload:
    # say so in a failure envelope rather than emitting `"data":` with nothing
    # after it and blaming the parser under test.
    [ -z "$err" ] && [ -z "$file" ] && err="fixture_missing"
    if [ -n "$err" ]; then
      printf '{"schema":"envelope/1","type":"envelope","ok":false,"command":"jobs %s","version":"0.0.0","where":null,"data":null,"error":{"code":"%s","message":"fake comfy jobs %s: %s","hint":null,"details":null}}\n' \
        "$sub" "$err" "$sub" "$err"
      exit 1
    fi
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"jobs %s","version":"0.0.0","where":null,"data":' "$sub"
    cat "$file"
    printf ',"error":null}\n'
    exit 0 ;;
  launch)
    # `comfy launch --background` as it answers a `--json` caller: one envelope
    # on stdout, then an exit, with the ComfyUI it started left running
    # elsewhere. This fake starts nothing and binds nothing — a test that needs
    # a launched server stands one up itself on an ephemeral port, which is the
    # only way readiness can be observed without a real ComfyUI.
    echo '{"schema":"envelope/1","type":"envelope","ok":true,"command":"launch","version":"0.0.0","where":null,"data":{"background":true,"listen":"127.0.0.1","port":8188,"url":"http://127.0.0.1:8188","pid":4242},"error":null,"changed":true}'
    exit 0 ;;
  launch_fail)
    # The launch failures that matter are the CLI's own verdicts:
    # `not_in_workspace` on a machine with no comfy-cli workspace — which is
    # this user's, since ComfyUI Desktop is not one — plus `port_in_use` and
    # `server_already_running`. The code is the caller's to choose, as in
    # fail_code, because what is being tested is uniform across all of them.
    printf '{"schema":"envelope/1","type":"envelope","ok":false,"command":"launch","version":"0.0.0","where":null,"data":null,"error":{"code":"%s","message":"%s","hint":null,"details":null}}\n' \
      "$FAKE_COMFY_ERROR_CODE" "$FAKE_COMFY_ERROR_MESSAGE"
    exit 1 ;;
  templates_ls)
    # `comfy templates ls`, serving a captured gallery response as data.
    # Modelled on data_file rather than on jobs: `templates` needs no
    # subcommand dispatch here, because only `ls` is served by this mode.
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"templates","version":"0.0.0","where":null,"data":'
    cat "$FAKE_COMFY_TEMPLATES_FILE"
    printf ',"error":null}\n'
    exit 0 ;;
  templates_fetch)
    # `comfy templates fetch <name> -o <path>`, copying a fixture workflow to
    # the requested destination. Modelled on run_capture's argv walk. The copy
    # is a byte copy: nothing here may reformat the JSON, because the test that
    # matters asserts a 2^64-1 widget value survives (non-negotiable #1).
    take=0
    dest=
    for arg in "$@"; do
      if [ "$take" = 1 ]; then dest="$arg"; break; fi
      [ "$arg" = "-o" ] && take=1
    done
    if [ -n "$dest" ] && [ -n "$FAKE_COMFY_TEMPLATE_FILE" ]; then
      mkdir -p "$(dirname "$dest")"
      cp "$FAKE_COMFY_TEMPLATE_FILE" "$dest"
    fi
    size=0
    [ -n "$dest" ] && [ -f "$dest" ] && size=$(wc -c < "$dest" | tr -d ' ')
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"templates fetch","version":"0.0.0","where":null,"data":{"name":"%s","title":"Fixture Template","output_type":"video","bytes":%s},"error":null}\n' "$FAKE_COMFY_TEMPLATE_NAME" "$size"
    exit 0 ;;
  validate)
    # `comfy validate`. The ok flag is a SEPARATE knob from the payload because
    # the real command decouples them: an invalid workflow comes back ok:false
    # with error:null and a fully populated data (measured 2026-08-09), which is
    # not the envelope contract every other command follows. A mode that forced
    # ok:true could not reproduce the case this whole module exists to handle.
    printf '{"schema":"envelope/1","type":"envelope","ok":%s,"command":"validate","version":"0.0.0","where":null,"data":' "${FAKE_COMFY_VALIDATE_OK:-true}"
    cat "$FAKE_COMFY_VALIDATE_FILE"
    printf ',"error":null}\n'
    [ "${FAKE_COMFY_VALIDATE_OK:-true}" = "true" ] || exit 1
    exit 0 ;;
  notes_file)
    # `comfy workflow notes`. A separate mode from data_file rather than a
    # reuse of it, because describe_workflow arms `slots` with data_file in the
    # same call and one $FAKE_COMFY_DATA_FILE cannot be two payloads.
    #
    # Unset means an empty listing rather than an error: a workflow with no
    # notes is an ordinary state (half of the real ones measured), so this is
    # the right default for every test that does not care about notes.
    printf '{"schema":"envelope/1","type":"envelope","ok":true,"command":"workflow notes","version":"0.0.0","where":null,"data":'
    if [ -n "$FAKE_COMFY_NOTES_FILE" ]; then
      cat "$FAKE_COMFY_NOTES_FILE"
    else
      printf '{"workflow":"","notes":[]}'
    fi
    printf ',"error":null}\n'
    exit 0 ;;
  *)
    echo "$OK"
    exit 0 ;;
esac
